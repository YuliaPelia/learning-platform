# Скопіюй цей файл у .env.local і заповни значення.
# .env.local НІКОЛИ не потрапляє на GitHub (він у .gitignore).

# Підключення до PostgreSQL
DATABASE_URL="postgresql://itc:itc@localhost:5432/itc_prisma?schema=public"

# Секрет для підпису сесій (будь-який довгий випадковий рядок, мінімум 32 символи).
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Адреса сайту (без / в кінці). Потрібна для returnUrl/serviceUrl WayForPay.
APP_URL=http://localhost:3000

# WayForPay — дані з особистого кабінету WayForPay (Налаштування магазину).
# Якщо MERCHANT_ACCOUNT порожній, у режимі розробки працює "тестова оплата" без реальних грошей.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_DOMAIN=
WAYFORPAY_SECRET_KEY=
# Пароль мерчанта потрібен лише для скасування регулярних платежів через regularApi.
WAYFORPAY_MERCHANT_PASSWORD=

# Вхід через Google. Адреса повернення в Google Cloud: APP_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Листи (необов'язково). Без ключа листи просто друкуються в консоль.
RESEND_API_KEY=
EMAIL_FROM="ITCodeCraft <hello@itcodecraft.tech>"

# Секрет для щоденної задачі /api/cron/daily (нагадування, продовження підписок).
CRON_SECRET=change-me-cron-secret

# Довіра до x-forwarded-for / x-real-ip для ліміту невдалих входів за IP.
# 1 — довіряти (лише якщо перед застосунком є проксі, що ПЕРЕЗАПИСУЄ ці заголовки);
# 0 — не довіряти (ліміт за IP вимкнений, діє лише ліміт за логіном).
# Якщо не задано: на Vercel (змінна VERCEL) — довіряємо, бо платформа сама ставить заголовки; деінде — ні,
# бо клієнт може підробити заголовок і обійти ліміт або заблокувати чужу IP.
TRUST_PROXY_HEADERS=

# ── Мобільний додаток (/api/mobile/v1) ──
# Секрет підпису access-токенів і квитків реєстрації мобільного додатка (мінімум 32 символи).
# ОКРЕМИЙ від SESSION_SECRET: витік одного не відкриває інше.
MOBILE_JWT_SECRET=change-me-to-another-long-random-string-of-at-least-32-chars
# Google client ID, які бекенд приймає як audience токена, через кому. Додаток отримує idToken
# з audience = WEB client ID (EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID), тож він має бути тут обов'язково.
GOOGLE_MOBILE_CLIENT_IDS=
# Bundle ID iOS-додатка — audience токена Sign in with Apple.
APPLE_BUNDLE_ID=tech.itcodecraft.app
