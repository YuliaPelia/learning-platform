# Скопіюй цей файл у .env.local і заповни значення.
# .env.local НІКОЛИ не потрапляє на GitHub (він у .gitignore).

# Підключення до PostgreSQL
DATABASE_URL="postgresql://itc:itc@localhost:5432/itc_prisma?schema=public"

# Секрет для підпису сесій (будь-який довгий випадковий рядок, мінімум 32 символи).
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Адреса сайту (без / в кінці). Потрібна для returnUrl/serviceUrl WayForPay.
APP_URL=http://localhost:3000

# WayForPay — дані з особистого кабінету WayForPay (Налаштування магазину).
# Якщо MERCHANT_ACCOUNT порожній, у режимі розробки працює "тестова оплата" без реальних грошей.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_DOMAIN=
WAYFORPAY_SECRET_KEY=
# Пароль мерчанта потрібен лише для скасування регулярних платежів через regularApi.
WAYFORPAY_MERCHANT_PASSWORD=

# Листи (необов'язково). Без ключа листи просто друкуються в консоль.
RESEND_API_KEY=
EMAIL_FROM="ITCodeCraft <hello@itcodecraft.tech>"

# Секрет для щоденної задачі /api/cron/daily (нагадування, продовження підписок).
CRON_SECRET=change-me-cron-secret
